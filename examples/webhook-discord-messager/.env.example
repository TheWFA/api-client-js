# The subscription's Ed25519 public key from the webhook management API
# (WebhookSubscription.publicKey), SPKI PEM format. Either paste it as a real
# multi-line value, or escape newlines as "\n" (both are supported).
WFA_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# A Discord "Incoming Webhook" URL for the channel you want notifications in.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx"

# server.ts only. Ignored by the Lambda adapter.
PORT=8080

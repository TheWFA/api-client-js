{
    "name": "@thewfa/api-client",
    "version": "1.0.0",
    "description": "Powerchair football API client",
    "license": "MIT",
    "author": "",
    "type": "module",
    "main": "./dist/main/index.js",
    "module": "./dist/module/index.js",
    "types": "./dist/module/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/module/index.d.ts",
            "import": "./dist/module/index.js",
            "require": "./dist/main/index.js",
            "default": "./dist/module/index.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TheWFA/api-client-js"
    },
    "bugs": {
        "url": "https://github.com/TheWFA/api-client-js/issues"
    },
    "homepage": "https://github.com/TheWFA/api-client-js#readme",
    "keywords": [
        "typescript",
        "api",
        "powerchair",
        "data",
        "sports",
        "football",
        "powersoccer",
        "soccer"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/main",
        "dist/module",
        "CHANGELOG.md",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "run-p build:*",
        "build:main": "tsc -p tsconfig.json && node scripts/write-cjs-package-json.cjs",
        "build:module": "tsc -p tsconfig.module.json",
        "clean": "rimraf dist",
        "prepublishOnly": "npm run build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "npm run build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/js": "^9.39.5",
        "@types/jest": "^30.0.0",
        "@types/qs": "^6.15.1",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.3.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "tsx": "^4.23.12",
        "typescript": "^6",
        "typescript-eslint": "^8.67.0"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "qs": "^6.15.3"
    }
}
